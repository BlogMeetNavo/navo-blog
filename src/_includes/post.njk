---
layout: base.njk
ogtype: article
---

<style>
.article-wrap {
  background: var(--linen);
  padding: calc(var(--nav-h) + 4rem) 2rem 6rem;
}

.article-inner {
  max-width: 760px;
  margin: 0 auto;
}

.back-link {
  display: inline-block;
  margin-bottom: 2rem;
  color: var(--salmon);
  text-decoration: none;
  font-weight: 600;
}

.post-cover {
  width: 100%;
  border-radius: 18px;
  margin-bottom: 2rem;
}

.post-title {
  font-size: clamp(2.2rem, 5vw, 4rem);
  line-height: 1.1;
  margin-bottom: 1rem;
  color: var(--ink);
}

.post-meta {
  font-size: 0.95rem;
  color: rgba(14,26,43,.55);
  margin-bottom: 2rem;
}

.post-body {
  font-size: 1.08rem;
  line-height: 1.85;
  color: rgba(14,26,43,.8);
}

.post-body p {
  margin-bottom: 1.5rem;
}

.post-cta {
  margin-top: 4rem;
  background: var(--navy);
  color: white;
  padding: 2rem;
  border-radius: 18px;
}
</style>

<main class="article-wrap">
  <article class="article-inner">

    <a href="/" class="back-link">← Back to all posts</a>

    {% if image %}
      <img src="{{ image }}" alt="{{ title }}" class="post-cover">
    {% endif %}

    <h1 class="post-title">{{ title }}</h1>

    <div class="post-meta">
      By {{ author }}
    </div>

    <div class="post-body">
      {{ content | safe }}
    </div>

    <div class="post-cta">
      <h3>Not sure where to start?</h3>
      <p>Take the free 15-minute check-in and see what you know, what’s missing, and where to begin.</p>
      <a href="https://tally.so/r/gDN0BP" target="_blank">Start the free check-in →</a>
    </div>

  </article>
</main>
