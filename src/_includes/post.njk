---
layout: base.njk
ogtype: article
---
<style>
.article-wrap {
  padding-top: calc(var(--nav-h) + 4rem);
  padding-bottom: 6rem;
  background: var(--linen);
}
.article-inner { max-width: 680px; margin: 0 auto; padding: 0 2rem; }
.back-link {
  display: inline-flex; align-items: center; gap: 0.4rem;
  font-size: 0.8rem; font-weight: 600; color: var(--salmon);
  text-decoration: none; margin-bottom: 2.5rem; transition: gap 0.2s;
}
.back-link:hover { gap: 0.65rem; }
.post-tag {
  font-size: 0.68rem; font-weight: 600;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--salmon); display: block; margin-bottom: 1rem;
}
.post-title {
  font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 700;
  letter-spacing: -0.025em; color: var(--ink); line-height: 1.15; margin-bottom: 1rem;
}
.post-meta {
  font-size: 0.78rem; color: rgba(14,26,43,0.55);
  margin-bottom: 2.5rem; padding-bottom: 2.5rem;
  border-bottom: 1px solid var(--linen-d);
}
.post-cover {
  width: 100%; border-radius: 10px; margin-bottom: 3rem; display: block;
  box-shadow: 0 8px 32px rgba(14,26,43,0.10);
}
.post-body { font-size: 1.02rem; line-height: 1.85; color: rgba(14,26,43,0.65); }
.post-body h2 {
  font-size: 1.4rem; font-weight: 700; letter-spacing: -0.02em;
  color: var(--ink); margin: 2.5rem 0 1rem; line-height: 1.2;
}
.post-body h3 { font-size: 1.1rem; font-weight: 700; color: var(--ink); margin: 2rem 0 0.75rem; }
.post-body p { margin-bottom: 1.4rem; }
.post-body p:last-child { margin-bottom: 0; }
.post-body ul, .post-body ol { padding-left: 1.5rem; margin-bottom: 1.4rem; }
.post-body li { margin-bottom: 0.5rem; line-height: 1.75; }
.post-body strong { color: var(--ink); font-weight: 600; }
.post-body a { color: var(--salmon); text-decoration: underline; }
.post-body blockquote {
  border-left: 3px solid var(--salmon); padding: 0.5rem 0 0.5rem 1.5rem;
  margin: 2rem 0; font-size: 1.08rem; color: var(--ink); font-weight: 500;
}
.post-footer {
  margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid var(--linen-d);
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
}
.post-author { font-size: 0.85rem; color: rgba(14,26,43,0.6); font-weight: 500; }
.post-author strong { color: var(--ink); }
.post-cta {
  background: var(--navy); border-radius: 12px;
  padding: 2.5rem 2rem; margin-top: 3.5rem; text-align: center;
}
.post-cta h3 {
  font-size: 1.2rem; font-weight: 700; color: var(--white);
  margin-bottom: 0.6rem; letter-spacing: -0.015em;
}
.post-cta p { font-size: 0.88rem; color: var(--text); line-height: 1.7; margin-bottom: 1.5rem; }
</style>

<div class="article-wrap">
  <div class="article-inner">
    <a href="/" class="back-link">← Back to all posts</a>
    <h1 class="post-title">{{ title }}</h1>
    <div class="post-meta">By <strong>{{ author | default: "Belinda" }}</strong> &nbsp;·&nbsp; {{ date | dateDisplay }}</div>    {% if image %}
    <img src="{{ image }}" alt="{{ title }}" class="post-cover">
    {% endif %}
    <div class="post-body">
      {{ content | safe }}
    </div>
    <div class="post-footer">
      <div class="post-author">Written by <strong>{{ author | default: "Belinda" }}</strong> – Founder, NAVO™</div>
      <a href="/" class="back-link">← All posts</a>
    </div>
    <div class="post-cta">
      <h3>Ready to take the first step?</h3>
      <p>See exactly what you know, what's missing, and where to start – with the free 15-minute check-in.</p>
      <a href="https://tally.so/r/gDN0BP" target="_blank" rel="noopener" class="btn btn-s">Start the free check-in →</a>
    </div>
  </div>
</div>
