      <li><a href="https://shop.meetnavo.com" target="_blank" rel="noopener">Guides.</a></li>
      <li><a href="https://meetnavo.com/real-conversations" target="_blank" rel="noopener">Real Conversations.</a></li>
      <li><a href="https://app.meetnavo.com" target="_blank" rel="noopener">Get Started.</a></li>
      <li class="ncta"><a href="https://tally.so/r/rjrdpo" target="_blank" rel="noopener">Stay Connected.</a></li>
    </ul>
    <button class="burger" id="burger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

