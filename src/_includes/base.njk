<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} – NAVO Blog</title>
<meta name="description" content="{{ description }}">
<meta name="robots" content="index, follow">
{% if permalink %}<link rel="canonical" href="https://blog.meetnavo.com{{ page.url }}">{% endif %}
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="https://blog.meetnavo.com{{ page.url }}">
<meta property="og:type" content="{{ ogtype | default('website') }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<style>
:root {
  --navy:     #0e1a2b;
  --navy-mid: #0b1422;
  --linen:    #f5f4f1;
  --linen-d:  #eceae4;
  --salmon:   #c8614a;
  --salmon-h: #b55540;
  --white:    #ffffff;
  --ink:      #0e1a2b;
  --text:     #b2c4d4;
  --muted:    #6e8299;
  --ink60:    rgba(14,26,43,0.60);
  --ink35:    rgba(14,26,43,0.35);
  --w08:      rgba(255,255,255,0.08);
  --w15:      rgba(255,255,255,0.15);
  --w50:      rgba(255,255,255,0.50);
  --max:      680px;
  --max-w:    1040px;
  --nav-h:    62px;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Instrument Sans', sans-serif;
  background: var(--navy);
  color: var(--text);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 400;
  height: var(--nav-h); padding: 0 2rem;
  display: flex; align-items: center;
  transition: background 0.35s, border-color 0.35s;
  border-bottom: 1px solid transparent;
}
.nav.scrolled {
  background: rgba(14,26,43,0.94);
  backdrop-filter: blur(14px);
  border-bottom-color: var(--w08);
}
.nav-inner {
  max-width: var(--max-w); margin: 0 auto; width: 100%;
  display: flex; align-items: center; justify-content: space-between;
}
.nav-logo { text-decoration: none; display: flex; align-items: center; }
.nav-logo img { height: 24px; width: auto; display: block; }
.nav-links { display: flex; align-items: center; list-style: none; }
.nav-links a {
  display: block; padding: 0.38rem 0.88rem;
  font-size: 0.8rem; font-weight: 500;
  color: var(--w50); text-decoration: none;
  border-radius: 999px; transition: color 0.2s;
}
.nav-links a:hover { color: var(--white); }
.nav-links .active a { color: var(--white); }
.nav-links .ncta a {
  background: var(--salmon); color: var(--white);
  padding: 0.4rem 1.1rem; font-weight: 600; margin-left: 0.4rem;
}
.nav-links .ncta a:hover { background: var(--salmon-h); }
.burger {
  display: none; flex-direction: column; gap: 5px;
  background: none; border: none; cursor: pointer; padding: 4px;
}
.burger span {
  display: block; width: 22px; height: 1.5px;
  background: var(--white); border-radius: 2px; transition: all 0.28s;
}
.burger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.burger.open span:nth-child(2) { opacity: 0; }
.burger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
.mob-nav {
  display: none; position: fixed;
  top: var(--nav-h); left: 0; right: 0;
  background: var(--navy-mid);
  border-bottom: 1px solid var(--w08);
  z-index: 399; padding: 1.25rem 2rem 1.75rem;
}
.mob-nav.open { display: block; }
.mob-nav ul { list-style: none; }
.mob-nav ul li a {
  display: block; padding: 0.75rem 0;
  color: var(--text); text-decoration: none;
  font-size: 0.98rem; font-weight: 500;
  border-bottom: 1px solid var(--w08); transition: color 0.2s;
}
.mob-nav ul li:last-child a { border: none; color: var(--salmon); font-weight: 600; }
.mob-nav ul li a:hover { color: var(--white); }
footer {
  background: var(--navy-mid);
  border-top: 1px solid var(--w08);
  padding: 2.25rem 2rem;
}
.footer-inner {
  max-width: var(--max-w); margin: 0 auto;
  display: flex; align-items: center;
  justify-content: space-between; flex-wrap: wrap; gap: 1.25rem;
}
.footer-l { display: flex; flex-direction: column; gap: 0.35rem; }
.footer-logo img { height: 22px; width: auto; display: block; }
.footer-loc { font-size: 0.72rem; color: var(--muted); }
.footer-r { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
.footer-r a { font-size: 0.72rem; color: var(--muted); text-decoration: none; transition: color 0.2s; }
.footer-r a:hover { color: var(--white); }
.footer-sep { color: var(--w15); }
.rh-wrap { display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none; }
.rh-wrap span { font-size: 0.72rem; color: var(--muted); }
.rh-wrap:hover span { color: var(--white); }
.btn {
  display: inline-flex; align-items: center; gap: 0.45rem;
  font-family: 'Instrument Sans', sans-serif;
  font-size: 0.875rem; font-weight: 600;
  padding: 0.82rem 1.75rem; border-radius: 999px;
  border: none; cursor: pointer; text-decoration: none;
  transition: all 0.2s; white-space: nowrap;
}
.btn:hover { transform: translateY(-2px); }
.btn-s { background: var(--salmon); color: var(--white); }
.btn-s:hover { background: var(--salmon-h); }
.btn-gw {
  background: transparent; color: var(--w50);
  border: 1px solid var(--w15);
}
.btn-gw:hover { color: var(--white); border-color: var(--w50); }
@media (max-width: 600px) {
  .nav-links { display: none; }
  .burger { display: flex; }
  .footer-inner { flex-direction: column; align-items: flex-start; }
}
</style>
</head>
<body>

<nav class="nav" id="nav">
  <div class="nav-inner">
