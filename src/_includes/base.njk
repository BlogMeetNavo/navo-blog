
<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - NAVO Journal</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="index, follow">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="https://blog.meetnavo.com{{ page.url }}">
  <meta property="og:type" content="website">
  {% if image %}
  <meta property="og:image" content="https://blog.meetnavo.com{{ image }}">
  {% endif %}

  <link rel="icon" type="image/png" href="/assets/favicon-navo.png">
  <link rel="apple-touch-icon" href="/assets/favicon-navo.png">

  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

  <style>
    :root {
      --navy: #0e1a2b;
      --navy-mid: #0b1422;
      --linen: #f5f4f1;
      --salmon: #c8614a;
      --salmon-h: #b55540;
      --white: #ffffff;
      --muted: #6e8299;
      --w08: rgba(255,255,255,0.08);
      --w15: rgba(255,255,255,0.15);
      --w50: rgba(255,255,255,0.50);
      --max-w: 1040px;
      --nav-h: 62px;
      --ink: #4d5155;
      --soft-ink: #777c80;
      --border: #e9e9e7;

      --navo-navy: #0C1320;
      --navo-salmon: #d45f49;
      --navo-text: #0C1320;
      --navo-frame-max: 1160px;
      --navo-radius: 18px;
      --navo-editorial-serif: Georgia, serif;
    }

    /* BR SEGMA - ACTUAL UPLOADED FONT FILES */

    @font-face {
      font-family: "BR Segma";
      src: url("/assets/BRSegma-Light-BF654d990a3c0f6.otf") format("opentype");
      font-weight: 300;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: "BR Segma";
      src: url("/assets/BRSegma-LightItalic-BF654d990a01834.otf") format("opentype");
      font-weight: 300;
      font-style: italic;
      font-display: swap;
    }

    @font-face {
      font-family: "BR Segma";
      src: url("/assets/BRSegma-Regular-BF654d990a3279a.otf") format("opentype");
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: "BR Segma";
      src: url("/assets/BRSegma-RegularItalic-BF654d990a11f54.otf") format("opentype");
      font-weight: 400;
      font-style: italic;
      font-display: swap;
    }

    @font-face {
      font-family: "BR Segma";
      src: url("/assets/BRSegma-Medium-BF654d9909e2529.otf") format("opentype");
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: "BR Segma";
      src: url("/assets/BRSegma-MediumItalic-BF654d990a246aa.otf") format("opentype");
      font-weight: 500;
      font-style: italic;
      font-display: swap;
    }

    @font-face {
      font-family: "BR Segma";
      src: url("/assets/BRSegma-SemiBold-BF654d990a3d889.otf") format("opentype");
      font-weight: 600;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: "BR Segma";
      src: url("/assets/BRSegma-SemiBoldItalic-BF654d990a21059.otf") format("opentype");
      font-weight: 600;
      font-style: italic;
      font-display: swap;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      width: 100%;
      min-height: 100%;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "BR Segma", "Avenir Next", Arial, sans-serif;
      font-weight: 400;
      color: var(--navo-text);
      background: #e4c5c8;
      -webkit-font-smoothing: antialiased;
    }

    button, input, select, textarea {
      font: inherit;
    }

    a {
      color: inherit;
    }

    /* NAVO MASTER WINDOW */

    .navo-viewport {
      height: 100vh;
      height: 100dvh;
      min-height: 0;
      padding: 12px;
      background: url("/assets/navo-background.png") center / cover no-repeat;
      display: flex;
      align-items: stretch;
      justify-content: center;
    }

    .navo-site {
      width: min(100%, var(--navo-frame-max));
      height: 100%;
      min-height: 0;
      display: flex;
      flex-direction: column;
      position: relative;
      background: #fff;
      border-radius: var(--navo-radius);
      box-shadow: 0 22px 80px rgba(52,48,67,0.16);
      overflow: hidden;
    }

    /* HEADER */

    .navo-topbar {
      height: 72px;
      flex: 0 0 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 30px;
      background: #fff;
      border-bottom: 1px solid #f0eeeb;
      z-index: 30;
    }

    .navo-brand {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
    }

    .navo-brand img {
      width: 74px;
      height: auto;
      display: block;
    }

    .navo-header-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .navo-menu-trigger {
      width: 40px;
      height: 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      align-items: center;
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    .navo-menu-trigger span {
      width: 25px;
      height: 2.5px;
      border-radius: 4px;
      background: var(--navo-navy);
    }
.navo-search-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 40px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--navo-navy);
  cursor: pointer;
}

.navo-search-trigger:hover {
  color: var(--navo-salmon);
}

.navo-search-panel {
  position: absolute;
  top: 80px;
  right: 20px;
  width: min(380px, calc(100% - 40px));
  max-height: calc(100% - 100px);
  overflow-y: auto;
  z-index: 45;
  background: #fff;
  border: 1px solid #e9e5e1;
  border-radius: 16px;
  padding: 22px;
  box-shadow: 0 15px 40px rgba(12,19,32,0.15);
}

.navo-search-panel[hidden] {
  display: none !important;
}

.navo-search-panel label {
  display: block;
  color: var(--navo-salmon);
  font-size: 11px;
  letter-spacing: 0.15em;
  margin-bottom: 14px;
}

#navo-search-input {
  width: 100%;
  border: 1px solid #dededb;
  border-radius: 999px;
  padding: 12px 16px;
  font-size: 14px;
  outline-offset: 3px;
}

#navo-search-results {
  margin-top: 12px;
}

.navo-search-result {
  display: block;
  padding: 12px 4px;
  border-bottom: 1px solid #efefec;
  text-decoration: none;
  color: var(--ink);
  font-size: 13px;
  line-height: 1.5;
}

.navo-search-result:hover {
  color: var(--navo-salmon);
}

.navo-search-empty {
  color: var(--soft-ink);
  font-size: 13px;
  padding: 12px 0;
}

.navo-search-trigger:focus-visible,
.navo-search-result:focus-visible {
  outline: 3px solid var(--navo-salmon);
  outline-offset: 3px;
}
    /* INNER SCROLLING CONTENT */

    .navo-scroll-content {
      min-height: 0;
      flex: 1 1 auto;
      overflow-y: auto;
      overflow-x: hidden;
      overscroll-behavior-y: contain;
      -webkit-overflow-scrolling: touch;
    }

    /* NAVO FOOTER */

    .navo-footer {
      flex: 0 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      padding: 14px 25px;
      color: #737985;
      font-size: 12px;
      background: #fff;
      border-top: 1px solid #eee;
    }

    .navo-footer-links {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      align-items: center;
    }

    .navo-footer a {
      text-decoration: none;
    }

    .navo-footer a:hover {
      text-decoration: underline;
    }

    /* EXPLORE MENU */

    .navo-menu-backdrop {
      position: absolute;
      inset: 72px 0 0;
      background: rgba(12,19,32,0.42);
      z-index: 35;
    }

    .navo-explore-menu {
      position: absolute;
      right: 16px;
      top: 80px;
      width: min(400px, calc(100% - 32px));
      max-height: calc(100% - 96px);
      overflow-y: auto;
      z-index: 40;
      background: white;
      border: 1px solid #e7dfd8;
      border-radius: 22px;
      box-shadow: 0 20px 50px rgba(12,19,32,0.2);
      padding: 25px 28px;
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .navo-explore-menu[hidden],
    .navo-menu-backdrop[hidden] {
      display: none !important;
    }

    .navo-menu-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      color: var(--navo-salmon);
      letter-spacing: 0.13em;
      font-weight: 500;
      font-size: 15px;
    }

    .navo-menu-close {
      border: 0;
      background: none;
      color: var(--navo-navy);
      font-size: 30px;
      line-height: 1;
      cursor: pointer;
      padding: 0 3px;
    }

    .navo-menu-links {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .navo-menu-links a {
      font-size: 15px;
      font-weight: 400;
      text-decoration: none;
      padding: 9px 0;
      line-height: 1.3;
      color: var(--navo-navy);
    }

    .navo-menu-links a:hover {
      color: var(--navo-salmon);
    }

    .navo-menu-links a.navo-current {
      color: var(--navo-salmon);
      font-weight: 500;
    }

    .navo-menu-divider {
      height: 1px;
      background: #e9e5e1;
      margin: 3px 0;
    }

    .navo-sign-in {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: var(--navo-navy);
      color: white;
      text-decoration: none;
      padding: 13px 26px;
      font-size: 15px;
      font-weight: 500;
    }

    .navo-sign-in:hover {
      opacity: 0.9;
    }

    .navo-menu-trigger:focus-visible,
    .navo-menu-close:focus-visible,
    .navo-explore-menu a:focus-visible {
      outline: 3px solid var(--navo-salmon);
      outline-offset: 3px;
    }

    /* JOURNAL CONTENT STYLES */

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 500;
      padding: 0.82rem 1.75rem;
      border-radius: 999px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-s {
      background: var(--salmon);
      color: #fff;
    }

    .btn-s:hover {
      background: var(--salmon-h);
    }

    .btn-gw {
      background: transparent;
      color: var(--ink);
      border: 1px solid #d9d9d6;
    }

    .btn-gw:hover {
      border-color: var(--salmon);
    }

    .hero {
      position: relative;
      overflow: hidden;
      background: #fff;
      padding: 45px 32px 75px;
      text-align: center;
    }

    .hero-glow {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 700px;
      height: 400px;
      pointer-events: none;
      background: radial-gradient(
        ellipse at 50% 0%,
        rgba(200,97,74,0.045) 0%,
        transparent 65%
      );
    }

    .hero-inner {
      max-width: 760px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    .hero-label,
    .posts-label {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--salmon);
      margin-bottom: 24px;
    }

    .hero-h {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(38px, 5vw, 68px);
      font-weight: 400;
      letter-spacing: -0.035em;
      color: #55595b;
      line-height: 1.12;
      margin: 0 0 22px;
    }

    .hero-sub {
      font-size: 15px;
      line-height: 1.85;
      color: #85888a;
      max-width: 520px;
      margin: 0 auto;
    }

    .posts-section {
      background: #faf9f7;
      padding: 70px 42px 85px;
      color: var(--ink);
    }

    .posts-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .posts-label {
      margin-bottom: 36px;
    }

    .posts-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .post-card {
      position: relative;
      display: flex;
      flex-direction: column;
      background: #fff;
      border: 1px solid #efefec;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 3px 14px rgba(30,30,30,0.025);
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .post-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 15px 35px rgba(30,30,30,0.065);
    }

    .post-card::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--salmon);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s;
    }

    .post-card:hover::after {
      transform: scaleX(1);
    }

    .post-card-img {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      background: #e9e9e7;
    }

    .post-card-img-placeholder {
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #e9e7e4;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .post-card-img-placeholder span {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #a2a2a0;
    }

    .post-card-body {
      padding: 26px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .post-tag {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--salmon);
    }

    .post-card-title {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 23px;
      font-weight: 400;
      letter-spacing: -0.015em;
      color: #505457;
      line-height: 1.3;
    }

    .post-card-excerpt {
      font-size: 13px;
      color: #85888a;
      line-height: 1.8;
      flex: 1;
    }

    .post-card-meta {
      font-size: 11px;
      color: #a0a2a4;
    }

    .post-card-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 500;
      color: var(--salmon);
      text-decoration: none;
      margin-top: 8px;
    }

    .post-card-link:hover {
      text-decoration: underline;
    }

    .cta-strip {
      background: #f4f0eb;
      padding: 65px 32px;
      text-align: center;
    }

    .cta-strip-inner {
      max-width: 560px;
      margin: 0 auto;
    }

    .cta-strip h2 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(28px, 3vw, 40px);
      font-weight: 400;
      letter-spacing: -0.025em;
      color: #55595b;
      line-height: 1.2;
      margin: 0 0 16px;
    }

    .cta-strip p {
      font-size: 14px;
      color: #838689;
      line-height: 1.8;
      margin: 0 0 28px;
    }

    .cta-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px;
    }

    /* RESPONSIVE */

    @media (max-width: 900px) {
      .posts-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 700px) {
      .navo-viewport {
        padding: 9px;
      }

      .navo-site {
        border-radius: 16px;
      }

      .navo-topbar {
        height: 64px;
        flex-basis: 64px;
        padding: 0 16px;
      }

      .navo-brand img {
        width: 68px;
      }

      .navo-menu-backdrop {
        inset: 64px 0 0;
      }

      .navo-explore-menu {
        top: 70px;
        left: 12px;
        right: 12px;
        width: auto;
        max-height: calc(100% - 82px);
        padding: 20px 22px;
      }

      .navo-footer {
        font-size: 10px;
        padding: 10px 13px;
        justify-content: center;
        text-align: center;
      }

      .navo-footer-links {
        justify-content: center;
        gap: 8px 13px;
      }
    }

    @media (max-width: 680px) {
      .hero {
        padding: 70px 22px 65px;
      }

      .hero-h {
        font-size: clamp(34px, 9vw, 48px);
      }

.hero-sub {
  font-size: 13px;
  line-height: 1.65;
}

      .posts-section {
        padding: 50px 22px 65px;
      }

      .posts-grid {
        grid-template-columns: 1fr;
      }

      .cta-strip {
        padding: 55px 22px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }

  </style>
</head>

<body>

  <div class="navo-viewport">
    <div class="navo-site">

      <!-- NAVO MASTER HEADER -->

      <header class="navo-topbar">
        <a
          class="navo-brand"
          href="https://meetnavo.com/"
          aria-label="Meet NAVO"
        >
          <img src="/assets/navo-logo.png" alt="NAVO">
        </a>

        <div class="navo-header-actions">
<div class="navo-search">
  <button type="button" class="navo-search-trigger"
    aria-label="Search Journal" aria-expanded="false"
    aria-controls="navo-search-panel">
    <svg width="21" height="21" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="1.8"
      stroke-linecap="round" stroke-linejoin="round"
      aria-hidden="true">
      <circle cx="10.8" cy="10.8" r="7.2"></circle>
      <path d="m16 16 5 5"></path>
    </svg>
  </button>
</div>
          <button
            type="button"
            class="navo-menu-trigger"
            aria-label="Open Explore menu"
            aria-controls="navo-explore-menu"
            aria-expanded="false"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </header>
<!-- JOURNAL SEARCH PANEL -->
<div class="navo-search-panel" id="navo-search-panel" hidden>
  <label for="navo-search-input">SEARCH JOURNAL</label>
  <input
    id="navo-search-input"
    type="search"
    placeholder="Search stories and topics..."
    autocomplete="off"
  >
  <div id="navo-search-results" aria-live="polite"></div>
</div>
      <!-- EXPLORE MENU -->

      <div class="navo-menu-backdrop" hidden></div>

      <nav
        id="navo-explore-menu"
        class="navo-explore-menu"
        aria-label="Explore NAVO"
        hidden
      >
        <div class="navo-menu-head">
          <span>EXPLORE</span>
          <button
            type="button"
            class="navo-menu-close"
            aria-label="Close Explore menu"
          >×</button>
        </div>

        <div class="navo-menu-links">
          <a href="https://meetnavo.com/">Meet NAVO</a>
          <a href="https://meetnavo.com/preview/my-navo/">Take a quick tour</a>
          <a
            href="https://blog.meetnavo.com/"
            class="navo-current"
            aria-current="page"
          >Journal</a>
          <a href="https://listen.meetnavo.com/">Listen</a>
          <a href="https://shop.meetnavo.com/">Shop</a>
          <a href="https://meetnavo.com/faq">FAQ</a>
        </div>

        <div class="navo-menu-divider"></div>

        <a
          class="navo-sign-in"
          href="https://app.meetnavo.com/signin"
        >Sign In</a>
      </nav>

      <!-- JOURNAL CONTENT -->

      <main
        class="navo-scroll-content navo-main"
        id="main-content"
      >
        {{ content | safe }}
      </main>

      <!-- NAVO MASTER FOOTER -->

      <footer class="navo-footer">
        <span>
          NAVO Care Pty Ltd. ACN 697 641 517
          Brisbane, Queensland, Australia.
        </span>

        <div class="navo-footer-links">
          <a href="https://meetnavo.com/">Home</a>
          <a href="https://meetnavo.com/about">About</a>
          <a href="https://research.meetnavo.com/">Research</a>
          <a href="https://meetnavo.com/about#partners">Partners</a>
          <a href="https://meetnavo.com/privacy">Privacy</a>
          <a href="https://meetnavo.com/terms">Terms</a>
          <a href="https://meetnavo.com/contact">Contact</a>
          <a href="https://www.rehuman.ing/">A RE:HUMAN™ Product</a>
        </div>
      </footer>

    </div>
  </div>

  <script>
    /* NAVO EXPLORE MENU */

    (function () {
      function init() {
        const trigger = document.querySelector(".navo-menu-trigger");
        const menu = document.getElementById("navo-explore-menu");
        const close = menu
          ? menu.querySelector(".navo-menu-close")
          : null;
        const backdrop = document.querySelector(".navo-menu-backdrop");

        if (!trigger || !menu || !close || !backdrop) {
          return;
        }

        function setOpen(open) {
          menu.hidden = !open;
          backdrop.hidden = !open;

          trigger.setAttribute(
            "aria-expanded",
            String(open)
          );

          trigger.setAttribute(
            "aria-label",
            open ? "Close Explore menu" : "Open Explore menu"
          );

          if (open) {
            close.focus();
          } else if (menu.contains(document.activeElement)) {
            trigger.focus();
          }
        }

        trigger.addEventListener("click", function () {
          setOpen(menu.hidden);
        });

        close.addEventListener("click", function () {
          setOpen(false);
        });

        backdrop.addEventListener("click", function () {
          setOpen(false);
        });

        menu.querySelectorAll("a").forEach(function (link) {
          link.addEventListener("click", function () {
            setOpen(false);
          });
        });

        document.addEventListener("keydown", function (event) {
          if (menu.hidden) {
            return;
          }

          if (event.key === "Escape") {
            setOpen(false);
            return;
          }

          if (event.key === "Tab") {
            const elements = Array.from(
              menu.querySelectorAll("button, a[href]")
            ).filter(function (element) {
              return !element.disabled;
            });

            if (!elements.length) {
              return;
            }

            const first = elements[0];
            const last = elements[elements.length - 1];

            if (
              event.shiftKey &&
              document.activeElement === first
            ) {
              event.preventDefault();
              last.focus();
            } else if (
              !event.shiftKey &&
              document.activeElement === last
            ) {
              event.preventDefault();
              first.focus();
            }
          }
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
/* NAVO JOURNAL SEARCH */
(function () {
  const trigger = document.querySelector(".navo-search-trigger");
  const panel = document.getElementById("navo-search-panel");
  const input = document.getElementById("navo-search-input");
  const results = document.getElementById("navo-search-results");

  if (!trigger || !panel || !input || !results) return;

  let posts = [];
  let loaded = false;

  function message(text) {
    results.textContent = "";
    const p = document.createElement("p");
    p.className = "navo-search-empty";
    p.textContent = text;
    results.appendChild(p);
  }

  async function loadPosts() {
    if (loaded) return true;
    try {
      const response = await fetch("/search-index.json");
      if (!response.ok) throw new Error("Search unavailable");
      const data = await response.json();
      if (!Array.isArray(data)) throw new Error("Invalid search index");
      posts = data;
      loaded = true;
      return true;
    } catch (error) {
      message("Search is temporarily unavailable.");
      return false;
    }
  }

  function search() {
    const query = input.value.trim().toLowerCase();
    results.textContent = "";

    if (!query) return;

    const matches = posts.filter(post =>
      [post.title, post.description, post.content,
       ...(Array.isArray(post.tags) ? post.tags : [])]
        .join(" ").toLowerCase().includes(query)
    ).slice(0, 12);

    if (!matches.length) {
      message("No matching stories found.");
      return;
    }

    matches.forEach(post => {
      const a = document.createElement("a");
      a.className = "navo-search-result";
      a.href = post.url;
      a.textContent = post.title;
      results.appendChild(a);
    });
  }

  function closeSearch() {
    panel.hidden = true;
    trigger.setAttribute("aria-expanded", "false");
  }

  trigger.addEventListener("click", async () => {
    if (!panel.hidden) {
      closeSearch();
      trigger.focus();
      return;
    }

    panel.hidden = false;
    trigger.setAttribute("aria-expanded", "true");
    input.focus();

    if (!loaded) {
      message("Loading stories...");
      if (await loadPosts()) search();
    }
  });

  input.addEventListener("input", search);

  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && !panel.hidden) {
      closeSearch();
      trigger.focus();
    }
  });

  document.addEventListener("click", event => {
    if (!panel.hidden &&
        !panel.contains(event.target) &&
        !trigger.contains(event.target)) {
      closeSearch();
    }
  });
})();
