<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} – NAVO Blog</title>
<meta name="description" content="{{ description }}">
<meta name="robots" content="index, follow">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="https://blog.meetnavo.com{{ page.url }}">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<style>
:root {
  --navy: #0e1a2b;
  --navy-mid: #0b1422;
  --linen: #f5f4f1;
  --salmon: #c8614a;
  --salmon-h: #b55540;
  --white: #ffffff;
  --muted: #6e8299;
  --w08: rgba(255,255,255,0.08);
  --w15: rgba(255,255,255,0.15);
  --w50: rgba(255,255,255,0.50);
  --max-w: 1040px;
  --nav-h: 62px;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Instrument Sans', sans-serif;
  background: var(--navy);
  color: #b2c4d4;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 400;
  height: var(--nav-h); padding: 0 2rem;
  display: flex; align-items: center;
  transition: background 0.35s;
  border-bottom: 1px solid transparent;
}
.nav.scrolled { background: rgba(14,26,43,0.94); backdrop-filter: blur(14px); border-bottom-color: var(--w08); }
.nav-inner { max-width: var(--max-w); margin: 0 auto; width: 100%; display: flex; align-items: center; justify-content: space-between; }
.nav-logo { text-decoration: none; display: flex; align-items: center; }
.nav-logo img { height: 24px; width: auto; display: block; }
.nav-links { display: flex; align-items: center; list-style: none; }
.nav-links a { display: block; padding: 0.38rem 0.88rem; font-size: 0.8rem; font-weight: 500; color: var(--w50); text-decoration: none; border-radius: 999px; transition: color 0.2s; }
.nav-links a:hover { color: var(--white); }
.nav-links .active a { color: var(--white); }
.nav-links .ncta a { background: var(--salmon); color: var(--white); padding: 0.4rem 1.1rem; font-weight: 600; margin-left: 0.4rem; }
.nav-links .ncta a:hover { background: var(--salmon-h); }
.burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
.burger span { display: block; width: 22px; height: 1.5px; background: var(--white); border-radius: 2px; transition: all 0.28s; }
.mob-nav { display: none; position: fixed; top: var(--nav-h); left: 0; right: 0; background: var(--navy-mid); border-bottom: 1px solid var(--w08); z-index: 399; padding: 1.25rem 2rem 1.75rem; }
.mob-nav.open { display: block; }
.mob-nav ul { list-style: none; }
.mob-nav ul li a { display: block; padding: 0.75rem 0; color: #b2c4d4; text-decoration: none; font-size: 0.98rem; font-weight: 500; border-bottom: 1px solid var(--w08); transition: color 0.2s; }
.mob-nav ul li:last-child a { border: none; color: var(--salmon); font-weight: 600; }
.mob-nav ul li a:hover { color: var(--white); }
footer { background: var(--navy-mid); border-top: 1px solid var(--w08); padding: 2.25rem 2rem; }
.footer-inner { max-width: var(--max-w); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.25rem; }
.footer-l { display: flex; flex-direction: column; gap: 0.35rem; }
.footer-logo img { height: 22px; width: auto; display: block; }
.footer-loc { font-size: 0.72rem; color: var(--muted); }
.footer-r { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
.footer-r a { font-size: 0.72rem; color: var(--muted); text-decoration: none; transition: color 0.2s; }
.footer-r a:hover { color: var(--white); }
.footer-sep { color: var(--w15); }
.btn { display: inline-flex; align-items: center; gap: 0.45rem; font-family: 'Instrument Sans', sans-serif; font-size: 0.875rem; font-weight: 600; padding: 0.82rem 1.75rem; border-radius: 999px; border: none; cursor: pointer; text-decoration: none; transition: all 0.2s; white-space: nowrap; }
.btn:hover { transform: translateY(-2px); }
.btn-s { background: var(--salmon); color: var(--white); }
.btn-s:hover { background: var(--salmon-h); }
.btn-gw { background: transparent; color: var(--w50); border: 1px solid var(--w15); }
.btn-gw:hover { color: var(--white); border-color: var(--w50); }
.hero { background: var(--navy); padding: calc(var(--nav-h) + 5rem) 2rem 5rem; text-align: center; position: relative; overflow: hidden; }
.hero-glow { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 700px; height: 400px; pointer-events: none; background: radial-gradient(ellipse at 50% 0%, rgba(200,97,74,0.08) 0%, transparent 65%); }
.hero-inner { max-width: 760px; margin: 0 auto; position: relative; z-index: 1; }
.hero-label { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--salmon); margin-bottom: 1.5rem; }
.hero-h { font-size: clamp(2.4rem, 6vw, 4.5rem); font-weight: 700; letter-spacing: -0.03em; color: var(--white); line-height: 1.05; margin-bottom: 1.25rem; }
.hero-sub { font-size: 1rem; line-height: 1.8; color: var(--muted); max-width: 480px; margin: 0 auto; }
.posts-section { background: var(--linen); padding: 6rem 2rem; color: var(--navy); }
.posts-inner { max-width: 1040px; margin: 0 auto; }
.posts-label { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--salmon); margin-bottom: 3rem; }
.posts-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 2rem; }
.post-card { background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(14,26,43,0.06); transition: transform 0.3s, box-shadow 0.3s; display: flex; flex-direction: column; position: relative; }
.post-card:hover { transform: translateY(-5px); box-shadow: 0 18px 48px rgba(14,26,43,0.12); }
.post-card::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px; background: var(--salmon); transform: scaleX(0); transform-origin: left; transition: transform 0.35s; }
.post-card:hover::after { transform: scaleX(1); }
.post-card-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; background: var(--navy); }
.post-card-img-placeholder { width: 100%; aspect-ratio: 16/9; background: linear-gradient(135deg, #0e1a2b 0%, #1a2f4a 100%); display: flex; align-items: center; justify-content: center; }
.post-card-img-placeholder span { font-size: 0.62rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.15); }
.post-card-body { padding: 1.75rem; flex: 1; display: flex; flex-direction: column; gap: 0.75rem; }
.post-tag { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--salmon); }
.post-card-title { font-size: 1.05rem; font-weight: 700; letter-spacing: -0.01em; color: var(--navy); line-height: 1.3; }
.post-card-excerpt { font-size: 0.87rem; color: rgba(14,26,43,0.55); line-height: 1.7; flex: 1; }
.post-card-meta { font-size: 0.72rem; color: rgba(14,26,43,0.4); }
.post-card-link { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; font-weight: 600; color: var(--salmon); text-decoration: none; transition: gap 0.2s; margin-top: 0.5rem; }
.post-card-link:hover { gap: 0.65rem; }
.cta-strip { background: var(--navy); padding: 5rem 2rem; text-align: center; }
.cta-strip-inner { max-width: 560px; margin: 0 auto; }
.cta-strip h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 700; letter-spacing: -0.025em; color: var(--white); line-height: 1.15; margin-bottom: 0.75rem; }
.cta-strip p { font-size: 0.92rem; color: var(--muted); line-height: 1.75; margin-bottom: 2rem; }
.cta-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.85rem; }
@media (max-width: 760px) { .posts-grid { grid-template-columns: 1fr; } }
@media (max-width: 600px) { .nav-links { display: none; } .burger { display: flex; } .footer-inner { flex-direction: column; align-items: flex-start; } }
</style>
</head>
<body>
<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href="https://meetnavo.com" class="nav-logo">
      <img src="/images/navo-logo.png" alt="NAVO">
    </a>
    <ul class="nav-links">
      <li><a href="https://meetnavo.com">Meet NAVO.</a></li>
      <li class="active"><a href="https://blog.meetnavo.com">Blog.</a></li>
      <li><a href="https://shop.meetnavo.com">Guides.</a></li>
      <li><a href="https://meetnavo.com/real-conversations">Real Conversations.</a></li>
      <li><a href="https://app.meetnavo.com">Get Started.</a></li>
      <li class="ncta"><a href="https://tally.so/r/rjrdpo">Stay Connected.</a></li>
    </ul>
    <button class="burger" id="burger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
<div class="mob-nav" id="mobNav">
  <ul>
    <li><a href="https://meetnavo.com">Meet NAVO.</a></li>
    <li><a href="https://blog.meetnavo.com">Blog.</a></li>
    <li><a href="https://shop.meetnavo.com">Guides.</a></li>
    <li><a href="https://meetnavo.com/real-conversations">Real Conversations.</a></li>
    <li><a href="https://app.meetnavo.com">Get Started.</a></li>
    <li><a href="https://tally.so/r/rjrdpo">Stay Connected.</a></li>
  </ul>
</div>

{{ content | safe }}

<footer>
  <div class="footer-inner">
    <div class="footer-l">
      <a href="https://meetnavo.com" class="footer-logo">
        <img src="/images/navo-logo.png" alt="NAVO">
      </a>
      <span class="footer-loc">Navo Care Pty Ltd. Brisbane, Queensland, Australia.</span>
    </div>
    <div class="footer-r">
      <a href="mailto:hello@meetnavo.com">Contact</a>
      <span class="footer-sep">·</span>
      <a href="https://meetnavo.com/privacy">Privacy</a>
      <span class="footer-sep">·</span>
      <span style="font-size:0.72rem; color:var(--muted);">A RE:HUMAN™ PRODUCT</span>
    </div>
  </div>
</footer>
<script>
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => { nav.classList.toggle('scrolled', window.scrollY > 30); }, { passive: true });
const burger = document.getElementById('burger');
const mobNav = document.getElementById('mobNav');
burger.addEventListener('click', () => { const o = burger.classList.toggle('open'); mobNav.classList.toggle('open', o); });
if (window.netlifyIdentity) { window.netlifyIdentity.on('init', user => { if (!user) { window.netlifyIdentity.on('login', () => { document.location.href = '/admin/'; }); } }); }
</script>
</body>
</html>
