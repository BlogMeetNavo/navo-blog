
<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - NAVO Journal</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="index, follow">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="https://blog.meetnavo.com{{ page.url }}">
  <meta property="og:type" content="website">
  {% if image %}
  <meta property="og:image" content="https://blog.meetnavo.com{{ image }}">
  {% endif %}

  <link rel="icon" type="image/png" href="/assets/favicon-navo.png">
  <link rel="apple-touch-icon" href="/assets/favicon-navo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

  <style>
    :root {
      --navy: #0e1a2b;
      --navy-mid: #0b1422;
      --linen: #f5f4f1;
      --salmon: #c8614a;
      --salmon-h: #b55540;
      --white: #ffffff;
      --muted: #6e8299;
      --w08: rgba(255,255,255,0.08);
      --w15: rgba(255,255,255,0.15);
      --w50: rgba(255,255,255,0.50);
      --max-w: 1040px;
      --nav-h: 62px;
      --ink: #4d5155;
      --soft-ink: #777c80;
      --border: #e9e9e7;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: "BR Segma", "Instrument Sans", Arial, sans-serif;
      background: #f4f0ec url("/assets/navo-background.png") center center / cover fixed no-repeat;
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
    }

    button, input, select, textarea {
      font: inherit;
    }

    a {
      color: inherit;
    }

    .navo-shell {
      width: min(1440px, calc(100% - 48px));
      min-height: calc(100vh - 48px);
      margin: 24px auto;
      background: #fff;
      border-radius: 22px;
      box-shadow: 0 16px 65px rgba(45, 43, 40, 0.07);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .nav {
      position: relative;
      z-index: 400;
      width: 100%;
      min-height: 82px;
      padding: 0 42px;
      background: #fff;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
    }

    .nav.scrolled {
      background: #fff;
    }

    .nav-inner {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .nav-logo {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      flex-shrink: 0;
    }

    .nav-logo img {
      display: block;
      width: auto;
      max-width: 160px;
      height: 32px;
      object-fit: contain;
    }

    .nav-logo-fallback {
      display: none;
      color: #909496;
      font-size: 25px;
      font-weight: 500;
      letter-spacing: -0.045em;
    }

    .nav-label {
      color: var(--salmon);
      font-size: 12px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 500;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .nav-home {
      color: #8b8e91;
      text-decoration: none;
      font-size: 13px;
      transition: color 0.2s;
    }

    .nav-home:hover {
      color: var(--salmon);
    }

    .burger {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 42px;
      height: 42px;
      padding: 9px;
      border: 1px solid #e8e8e6;
      border-radius: 50%;
      background: transparent;
      cursor: pointer;
    }

    .burger span {
      display: block;
      width: 19px;
      height: 1.5px;
      background: #888d90;
      border-radius: 2px;
    }

    .burger:hover {
      border-color: var(--salmon);
    }

    .mob-nav {
      display: none;
      position: relative;
      z-index: 399;
      background: #fff;
      border-bottom: 1px solid var(--border);
      padding: 22px 42px 30px;
    }

    .mob-nav.open {
      display: block;
    }

    .mob-nav ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 40px;
    }

    .mob-nav a {
      display: block;
      padding: 13px 0;
      border-bottom: 1px solid #f0f0ee;
      color: #676b6e;
      text-decoration: none;
      font-size: 14px;
    }

    .mob-nav a:hover,
    .mob-nav a[aria-current="page"] {
      color: var(--salmon);
    }

    .navo-main {
      flex: 1;
      min-width: 0;
    }

    /* Existing Journal components retained */

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 500;
      padding: 0.82rem 1.75rem;
      border-radius: 999px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-s {
      background: var(--salmon);
      color: #fff;
    }

    .btn-s:hover {
      background: var(--salmon-h);
    }

    .btn-gw {
      background: transparent;
      color: var(--ink);
      border: 1px solid #d9d9d6;
    }

    .btn-gw:hover {
      border-color: var(--salmon);
    }

    .hero {
      position: relative;
      overflow: hidden;
      background: #fff;
      padding: 90px 32px 75px;
      text-align: center;
    }

    .hero-glow {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 700px;
      height: 400px;
      pointer-events: none;
      background: radial-gradient(
        ellipse at 50% 0%,
        rgba(200,97,74,0.045) 0%,
        transparent 65%
      );
    }

    .hero-inner {
      max-width: 760px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    .hero-label,
    .posts-label {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--salmon);
      margin-bottom: 24px;
    }

    .hero-h {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(38px, 5vw, 68px);
      font-weight: 400;
      letter-spacing: -0.035em;
      color: #55595b;
      line-height: 1.12;
      margin: 0 0 22px;
    }

    .hero-sub {
      font-size: 15px;
      line-height: 1.85;
      color: #85888a;
      max-width: 520px;
      margin: 0 auto;
    }

    .posts-section {
      background: #faf9f7;
      padding: 70px 42px 85px;
      color: var(--ink);
    }

    .posts-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .posts-label {
      margin-bottom: 36px;
    }

    .posts-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .post-card {
      position: relative;
      display: flex;
      flex-direction: column;
      background: #fff;
      border: 1px solid #efefec;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 3px 14px rgba(30,30,30,0.025);
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .post-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 15px 35px rgba(30,30,30,0.065);
    }

    .post-card::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--salmon);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s;
    }

    .post-card:hover::after {
      transform: scaleX(1);
    }

    .post-card-img {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      background: #e9e9e7;
    }

    .post-card-img-placeholder {
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #e9e7e4;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .post-card-img-placeholder span {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #a2a2a0;
    }

    .post-card-body {
      padding: 26px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .post-tag {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--salmon);
    }

    .post-card-title {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 23px;
      font-weight: 400;
      letter-spacing: -0.015em;
      color: #505457;
      line-height: 1.3;
    }

    .post-card-excerpt {
      font-size: 13px;
      color: #85888a;
      line-height: 1.8;
      flex: 1;
    }

    .post-card-meta {
      font-size: 11px;
      color: #a0a2a4;
    }

    .post-card-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 500;
      color: var(--salmon);
      text-decoration: none;
      margin-top: 8px;
    }

    .post-card-link:hover {
      text-decoration: underline;
    }

    .cta-strip {
      background: #f4f0eb;
      padding: 65px 32px;
      text-align: center;
    }

    .cta-strip-inner {
      max-width: 560px;
      margin: 0 auto;
    }

    .cta-strip h2 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(28px, 3vw, 40px);
      font-weight: 400;
      letter-spacing: -0.025em;
      color: #55595b;
      line-height: 1.2;
      margin: 0 0 16px;
    }

    .cta-strip p {
      font-size: 14px;
      color: #838689;
      line-height: 1.8;
      margin: 0 0 28px;
    }

    .cta-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px;
    }

    /* NAVO footer */

    .navo-footer {
      padding: 26px 42px;
      background: #fff;
      border-top: 1px solid var(--border);
    }

    .footer-inner {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 18px;
    }

    .footer-l {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .footer-loc {
      font-size: 11px;
      color: #9b9d9f;
    }

    .footer-r {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 18px;
    }

    .footer-r a,
    .footer-r span {
      font-size: 11px;
      color: #929597;
      text-decoration: none;
    }

    .footer-r a:hover {
      color: var(--salmon);
    }

    .footer-sep {
      color: #dededb !important;
    }

    @media (max-width: 900px) {
      .posts-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 680px) {
      body {
        background-attachment: scroll;
      }

      .navo-shell {
        width: calc(100% - 20px);
        min-height: calc(100vh - 20px);
        margin: 10px auto;
        border-radius: 16px;
      }

      .nav {
        min-height: 68px;
        padding: 0 20px;
      }

      .nav-logo img {
        max-width: 130px;
        height: 28px;
      }

      .nav-label {
        display: none;
      }

      .nav-actions {
        gap: 12px;
      }

      .nav-home {
        display: none;
      }

      .mob-nav {
        padding: 15px 22px 24px;
      }

      .mob-nav ul {
        grid-template-columns: 1fr;
        gap: 0;
      }

      .hero {
        padding: 70px 22px 65px;
      }

      .hero-h {
        font-size: clamp(34px, 9vw, 48px);
      }

      .hero-sub {
        font-size: 14px;
      }

      .posts-section {
        padding: 50px 22px 65px;
      }

      .posts-grid {
        grid-template-columns: 1fr;
      }

      .cta-strip {
        padding: 55px 22px;
      }

      .navo-footer {
        padding: 26px 22px;
      }

      .footer-inner {
        flex-direction: column;
        align-items: flex-start;
      }

      .footer-r {
        gap: 12px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>

  <div class="navo-shell">

    <header class="nav" id="nav">
      <div class="nav-inner">

        <a href="https://meetnavo.com" class="nav-logo" aria-label="Meet NAVO home">
          <img
            src="/assets/navo-logo.png"
            alt="NAVO"
            onerror="this.style.display='none';this.nextElementSibling.style.display='inline';"
          >
          <span class="nav-logo-fallback">NAVO</span>
        </a>

        <div class="nav-actions">
          <span class="nav-label">Journal</span>

          <a href="https://meetnavo.com" class="nav-home">Meet NAVO</a>

          <button
            class="burger"
            id="burger"
            type="button"
            aria-label="Explore NAVO"
            aria-controls="mobNav"
            aria-expanded="false"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>

      </div>
    </header>

    <nav class="mob-nav" id="mobNav" aria-label="Explore NAVO">
      <ul>
        <li><a href="https://meetnavo.com">Meet NAVO</a></li>
        <li><a href="https://blog.meetnavo.com" aria-current="page">Journal</a></li>
        <li><a href="https://listen.meetnavo.com">Listen</a></li>
        <li><a href="https://shop.meetnavo.com">Shop</a></li>
        <li><a href="https://research.meetnavo.com">Research</a></li>
        <li><a href="https://meetnavo.com/get-involved">Get Involved</a></li>
        <li><a href="https://app.meetnavo.com">My NAVO</a></li>
      </ul>
    </nav>

    <main class="navo-main" id="main-content">
      {{ content | safe }}
    </main>

    <footer class="navo-footer">
      <div class="footer-inner">

        <div class="footer-l">
          <span class="footer-loc">NAVO Care Pty Ltd</span>
          <span class="footer-loc">A RE:HUMAN™ PRODUCT</span>
        </div>

        <div class="footer-r">
          <a href="https://meetnavo.com">Meet NAVO</a>
          <span class="footer-sep">·</span>
          <a href="https://meetnavo.com/privacy">Privacy</a>
          <span class="footer-sep">·</span>
          <a href="https://meetnavo.com/get-involved">Get Involved</a>
        </div>

      </div>
    </footer>

  </div>

  <script>
    (function () {
      const burger = document.getElementById("burger");
      const menu = document.getElementById("mobNav");

      if (burger && menu) {
        burger.addEventListener("click", function () {
          const isOpen = menu.classList.toggle("open");
          burger.setAttribute("aria-expanded", String(isOpen));
        });

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") {
            menu.classList.remove("open");
            burger.setAttribute("aria-expanded", "false");
          }
        });

        document.addEventListener("click", function (event) {
          if (!menu.contains(event.target) && !burger.contains(event.target)) {
            menu.classList.remove("open");
            burger.setAttribute("aria-expanded", "false");
          }
        });
      }

      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", function (user) {
          if (!user) {
            window.netlifyIdentity.on("login", function () {
              document.location.href = "/admin/";
            });
          }
        });
      }
    })();
  </script>

</body>
</html>
