---
permalink: /search-index.json
eleventyExcludeFromCollections: true
layout: false
---
[
{% for post in collections.posts %}
  {
    "title": {{ post.data.title | dump | safe }},
    "description": {{ post.data.description | dump | safe }},
    "tags": {{ post.data.tags | default([], true) | dump | safe }},
    "content": {{ post.templateContent | striptags | dump | safe }},
    "url": {{ post.url | dump | safe }},
    "image": {{ post.data.image | default("", true) | dump | safe }},
    "date": {{ post.data.date | dateDisplay | dump | safe }}
  }{% if not loop.last %},{% endif %}
{% endfor %}
]

